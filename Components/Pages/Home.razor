@page "/"
@using System.Globalization
@inject PadelMatchSync.Services.ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Padel Match Sync — Plan your match day</PageTitle>

<div class="dashboard">
    <aside class="sidebar">
        <a class="brand" href="./" aria-label="Padel Match Sync home"><img class="brand-mark" src="padel-match-sync-icon.svg" alt="" /><span class="brand-name">Padel Match Sync</span></a>
        <div class="team-switch"><div class="team-avatar">🎾</div><div><strong>Weekend crew</strong><small>4 players</small></div><span class="chevron">⌄</span></div>
        <div class="nav-label">WORKSPACE</div>
        <nav class="side-nav" aria-label="Main navigation">
            <a class="nav-item active" href="#today"><span class="nav-icon">▦</span>My day</a>
            <a class="nav-item" href="#schedule"><span class="nav-icon">◷</span>Schedule</a>
            <a class="nav-item" href="#players"><span class="nav-icon">♧</span>Players <span class="nav-count">4</span></a>
        </nav>
        <div class="sidebar-bottom"><div class="weather-card"><span class="weather-icon">☀</span><div><strong>Great day to play</strong><small>24° · Clear skies</small></div></div><div class="profile"><div class="profile-avatar">A</div><div><strong>Alex Marin</strong><small>Organizer</small></div><button class="more" aria-label="More options">···</button></div></div>
    </aside>

    <main class="main-content" id="today">
        <header class="topbar"><a class="mobile-brand" href="./" aria-label="Padel Match Sync home"><img src="padel-match-sync-icon.svg" alt="" /><span>Padel Match Sync</span></a><div class="breadcrumb">Weekend crew <span>/</span> <strong>My day</strong></div><div class="top-actions"><button class="account-button" @onclick="ToggleAccount">@(Api.IsSignedIn ? Api.DisplayName : "Sign in")</button><button class="icon-button notification" aria-label="Notifications">♧<i></i></button><div class="top-avatar">@(Api.DisplayName?.FirstOrDefault() ?? 'A')</div></div></header>
        <div class="content-wrap">
            <div class="page-heading"><div><div class="eyebrow">SATURDAY, OCTOBER 10, 2026 <span class="sun">☀</span></div><h1>Make today <em>count.</em></h1><p class="subheading">Your match day, all in one place.</p></div><button class="primary-button" @onclick="OpenPlanner"><span>＋</span> Plan a match</button></div>

            <section class="hero-card" aria-label="Next match">
                <div class="hero-top"><span class="live-label"><span></span> NEXT MATCH</span><button class="dots-button" aria-label="Match options">···</button></div>
                <div class="match-main"><div><div class="match-time">10:30 <span>AM</span></div><div class="match-date">Saturday, October 10</div></div><div class="match-divider"></div><div class="match-location"><div class="court-icon">⌖</div><div><strong>Padel House</strong><small>Court 3 · 60 min</small></div></div><div class="countdown"><strong>02<span>days</span></strong><small>until first serve</small></div></div>
                <div class="hero-bottom"><div class="attending"><div class="avatar-stack"><span class="player p1">A</span><span class="player p2">M</span><span class="player p3">J</span><span class="player p4">S</span></div><span><strong>4 players</strong> are in</span></div><button class="text-button" @onclick="ToggleDetails">@(showDetails ? "Hide details" : "Match details") <span>→</span></button></div>
                @if (showDetails) { <div class="match-details"><div><small>TEAMS</small><strong>Alex &amp; Maya <span>vs</span> Jordan &amp; Sam</strong></div><div><small>NOTES</small><strong>Bring a new can of balls</strong></div></div> }
            </section>

            @if (Api.IsSignedIn)
            {
                <section class="my-matches-panel"><div class="section-heading compact"><div><h2>Your planned matches</h2><p>Invite your crew with a private link.</p></div><span class="progress-count">@myMatches.Count</span></div>
                    @if (myMatches.Count == 0) { <p class="empty-matches">No saved matches yet. Plan one and share it with your players.</p> }
                    else { @foreach (var savedMatch in myMatches) { var shareUrl = Navigation.ToAbsoluteUri($"match/{savedMatch.ShareCode}").ToString(); <article class="saved-match"><div><strong>@savedMatch.Name</strong><small>@savedMatch.Venue · @savedMatch.Availability.Count @(savedMatch.Availability.Count == 1 ? "date" : "dates") · @savedMatch.ResponseCount responses</small></div><a href="@shareUrl">Open invite ↗</a></article> } }
                </section>
            }

            <div class="below-grid">
                <section class="schedule-panel" id="schedule"><div class="section-heading"><div><h2>Today’s plan</h2><p>A little prep goes a long way.</p></div><button class="link-button" @onclick="OpenPlanner">View schedule <span>→</span></button></div>
                    <div class="timeline">
                        <div class="timeline-row"><div class="timeline-time">9:30 <small>AM</small></div><div class="timeline-track"><span class="timeline-dot muted"></span></div><div class="event-card prep"><div class="event-icon">☕</div><div class="event-copy"><strong>Easy morning</strong><small>Take it slow, hydrate &amp; fuel up</small></div><span class="event-tag">PERSONAL</span></div></div>
                        <div class="timeline-row"><div class="timeline-time">10:00 <small>AM</small></div><div class="timeline-track"><span class="timeline-dot green"></span></div><div class="event-card warmup"><div class="event-icon">↗</div><div class="event-copy"><strong>Head to Padel House</strong><small>Allow 15 min travel · Leave by 10:00</small></div><span class="event-tag travel-tag">TRAVEL</span></div></div>
                        <div class="timeline-row"><div class="timeline-time">10:30 <small>AM</small></div><div class="timeline-track"><span class="timeline-dot orange"></span></div><div class="event-card match-event"><div class="event-icon">🎾</div><div class="event-copy"><strong>Saturday rally</strong><small>Court 3 · Padel House</small></div><span class="event-tag match-tag">MATCH</span></div></div>
                        <div class="timeline-row"><div class="timeline-time">12:00 <small>PM</small></div><div class="timeline-track"><span class="timeline-dot muted"></span></div><button class="add-event" @onclick="OpenPlanner"><span>＋</span> Add something after</button></div>
                    </div>
                </section>
                <aside class="right-column"><section class="week-panel"><div class="section-heading compact"><div><h2>Your week</h2><p>October 5 – 11</p></div><button class="arrow-button" aria-label="Next week">→</button></div><div class="week-days">@foreach (var day in WeekDays) { <button class="day-cell @(day.Date == SelectedDay ? "selected" : "") @(day.HasMatch ? "has-match" : "")" @onclick="() => SelectDay(day.Date)"><span>@day.Label</span><strong>@day.Date.Day</strong><i></i></button> }</div><div class="week-foot"><span><i></i> Match day</span><strong>1 match planned</strong></div></section>
                    <section class="checklist-panel"><div class="section-heading compact"><div><h2>Match checklist</h2><p>Get ready to play</p></div><span class="progress-count">@checkedItems.Count/4</span></div><div class="check-items"><label class="check-item"><input type="checkbox" checked="@checkedItems.Contains(0)" @onchange="() => ToggleCheck(0)" /><span class="checkmark"></span><span>Confirm the court booking</span></label><label class="check-item"><input type="checkbox" checked="@checkedItems.Contains(1)" @onchange="() => ToggleCheck(1)" /><span class="checkmark"></span><span>Check who’s playing</span></label><label class="check-item"><input type="checkbox" checked="@checkedItems.Contains(2)" @onchange="() => ToggleCheck(2)" /><span class="checkmark"></span><span>Pack your racket &amp; gear</span></label><label class="check-item"><input type="checkbox" checked="@checkedItems.Contains(3)" @onchange="() => ToggleCheck(3)" /><span class="checkmark"></span><span>Bring water &amp; balls</span></label></div><button class="checklist-link" @onclick="OpenPlanner">Edit checklist <span>→</span></button></section>
                </aside>
            </div>
            <footer class="footer-note"><span>Made for the love of the game <span class="heart">♥</span></span><span>PADEL MATCH SYNC</span></footer>
        </div>
    </main>
</div>

<nav class="mobile-nav" aria-label="Mobile navigation"><a class="active" href="#today"><span>▦</span>Today</a><a href="#schedule"><span>◷</span>Schedule</a><a href="#players"><span>♧</span>Players</a><button @onclick="OpenPlanner"><span>＋</span>Plan</button></nav>

@if (showPlanner)
{
    <div class="modal-backdrop" @onclick="ClosePlanner">
        <section class="planner-modal" @onclick:stopPropagation="true" aria-label="Plan a match">
            <button class="modal-close" @onclick="ClosePlanner" aria-label="Close">×</button>
            <div class="modal-kicker">GET YOUR CREW TOGETHER</div>
            <h2>Plan a match</h2>
            <p>Choose a day or a date range, then add your availability.</p>
                <label>Match name<input @bind="matchName" placeholder="e.g. Saturday rally" /></label>

            <div class="date-mode" role="group" aria-label="Date selection type">
                <button class="date-mode-button @(!useDateRange ? "active" : "")" @onclick="() => SetDateMode(false)">One day</button>
                <button class="date-mode-button @(useDateRange ? "active" : "")" @onclick="() => SetDateMode(true)">Date range</button>
            </div>

            @if (!useDateRange)
            {
                <label>Match day<input type="date" @bind="matchDate" /></label>
                <div class="availability-editor">
                    <div class="availability-heading"><div><strong>Your availability</strong><small>@matchDate.ToString("dddd, MMMM d")</small></div><select aria-label="Availability for selected day" value="@singleDay.Status" @onchange="e => SetSingleStatus(e.Value?.ToString())"><option value="">Choose availability</option><option>Available</option><option>Maybe</option><option>Unavailable</option></select></div>
                    @if (singleDay.Status is "Available" or "Maybe")
                    {
                        <div class="time-window"><span>Free between</span><input aria-label="Available from" type="time" @bind="singleDay.From" /><span>and</span><input aria-label="Available until" type="time" @bind="singleDay.Until" /></div>
                    }
                    @if (SingleWindowInvalid)
                    {
                        <div class="range-message error">Choose an end time after the start time.</div>
                    }
                    @if (string.IsNullOrEmpty(singleDay.Status))
                    {
                        <div class="availability-prompt">Choose Available, Maybe, or Unavailable to continue.</div>
                    }
                </div>
            }
            else
            {
                <div class="form-row range-fields">
                    <label>From<input type="date" @bind="rangeStart" @bind:after="RefreshRangeDays" /></label>
                    <label>Through<input type="date" @bind="rangeEnd" @bind:after="RefreshRangeDays" /></label>
                </div>
                @if (!IsRangeValid)
                {
                    <div class="range-message error">Choose an end date after the start date, within a 31-day window.</div>
                }
                else
                {
                    <div class="availability-editor range-editor">
                        <div class="availability-heading range-heading"><div><strong>Set availability for each day</strong><small>@rangeAvailability.Count @(rangeAvailability.Count == 1 ? "day" : "days") in this date range</small></div><span class="status-legend">Available · Maybe · Unavailable</span></div>
                        <div class="availability-list">
                            @foreach (var day in rangeAvailability)
                            {
                                <div class="availability-row">
                                    <div class="availability-day"><strong>@day.Date.ToString("ddd")</strong><small>@day.Date.ToString("MMM d")</small></div>
                                    <select aria-label="Availability for @day.Date.ToString("dddd, MMMM d")" value="@day.Status" @onchange="e => UpdateStatus(day, e.Value?.ToString())"><option value="">Choose</option><option>Available</option><option>Maybe</option><option>Unavailable</option></select>
                                    @if (day.Status is "Available" or "Maybe")
                                    {
                                        <input aria-label="Available from on @day.Date.ToString("MMM d")" type="time" @bind="day.From" />
                                        <span class="time-separator">to</span>
                                        <input aria-label="Available until on @day.Date.ToString("MMM d")" type="time" @bind="day.Until" />
                                    }
                                </div>
                            }
                        </div>
                        @if (RangeWindowInvalid)
                        {
                            <div class="range-message error">End each time window after its start time.</div>
                        }
                        @if (!IsRangeAvailabilityComplete)
                        {
                            <div class="availability-prompt">Set an availability for every day in the range.</div>
                        }
                    </div>
                }
            }

            <label>Where are you playing?<input @bind="venue" placeholder="Court or club name" /></label>
            @if (!Api.IsSignedIn) { <div class="availability-prompt">Sign in to save this plan and get a shareable match link.</div> }
            <button class="primary-button modal-submit" @onclick="SaveMatch" disabled="@(!CanSaveAvailability || !Api.IsSignedIn)">@(saving ? "Saving…" : "Create & share match") <span>→</span></button>
        </section>
    </div>
}
@if (showAccount)
{
    <div class="modal-backdrop" @onclick="ToggleAccount"><section class="planner-modal auth-modal" @onclick:stopPropagation="true" aria-label="Account">
        <button class="modal-close" @onclick="ToggleAccount" aria-label="Close">×</button><div class="modal-kicker">YOUR MATCHES, YOUR CREW</div><h2>@(Api.IsSignedIn ? $"Hi, {Api.DisplayName}" : accountMode == "register" ? "Create your account" : "Welcome back")</h2>
        @if (Api.IsSignedIn) { <p>Your matches are saved securely to your account.</p><button class="primary-button modal-submit" @onclick="SignOut">Sign out</button> }
        else { @if (accountMode == "register") { <label>Your name<input @bind="accountName" autocomplete="name" placeholder="Your name" /></label> }<label>Email<input type="email" @bind="accountEmail" autocomplete="email" placeholder="you@example.com" /></label><label>Password<input type="password" @bind="accountPassword" autocomplete="@(accountMode == "register" ? "new-password" : "current-password")" placeholder="@(accountMode == "register" ? "At least 10 characters" : "Your password")" /></label>
            @if (!string.IsNullOrWhiteSpace(accountError)) { <div class="range-message error">@accountError</div> }
            <button class="primary-button modal-submit" @onclick="Authenticate" disabled="@accountBusy">@(accountBusy ? "Please wait…" : accountMode == "register" ? "Create account" : "Sign in") <span>→</span></button><button class="auth-switch" @onclick="SwitchAccountMode">@(accountMode == "register" ? "Already have an account? Sign in" : "New here? Create an account")</button> }
    </section></div>
}
@if (!string.IsNullOrWhiteSpace(toastMessage)) { <div class="toast">✓ &nbsp;@toastMessage @if (!string.IsNullOrWhiteSpace(lastShareUrl)) { <a href="@lastShareUrl">Open share link →</a> }</div> }

@code {
    private bool showDetails;
    private bool showPlanner;
    private bool useDateRange;
    private bool showAccount;
    private bool accountBusy;
    private bool saving;
    private string accountMode = "login";
    private string accountName = "";
    private string accountEmail = "";
    private string accountPassword = "";
    private string accountError = "";
    private string lastShareUrl = "";
    private List<PadelMatchSync.Services.MatchSummary> myMatches = [];
    private string matchName = "Saturday rally";
    private DateTime matchDate = new(2026, 10, 10);
    private DateTime rangeStart = new(2026, 10, 10);
    private DateTime rangeEnd = new(2026, 10, 12);
    private DayAvailability singleDay = new() { From = new(10, 0), Until = new(20, 0) };
    private List<DayAvailability> rangeAvailability = new();
    private string venue = "Padel House";
    private string? toastMessage;
    private DateTime SelectedDay = new(2026, 10, 10);
    private readonly HashSet<int> checkedItems = new() { 0, 1 };
    private record DayItem(string Label, DateTime Date, bool HasMatch);
    private class DayAvailability
    {
        public DateTime Date { get; set; }
        public string Status { get; set; } = "";
        public TimeOnly From { get; set; } = new(17, 0);
        public TimeOnly Until { get; set; } = new(20, 0);
    }
    private bool IsRangeValid => rangeEnd.Date >= rangeStart.Date && (rangeEnd.Date - rangeStart.Date).TotalDays < 31;
    private bool IsRangeAvailabilityComplete => rangeAvailability.Count > 0 && rangeAvailability.All(day => !string.IsNullOrEmpty(day.Status));
    private bool RangeWindowInvalid => rangeAvailability.Any(day => (day.Status is "Available" or "Maybe") && day.From >= day.Until);
    private bool SingleWindowInvalid => (singleDay.Status is "Available" or "Maybe") && singleDay.From >= singleDay.Until;
    private bool CanSaveAvailability => useDateRange ? IsRangeValid && IsRangeAvailabilityComplete && !RangeWindowInvalid : !string.IsNullOrEmpty(singleDay.Status) && !SingleWindowInvalid;
    private IReadOnlyList<DayItem> WeekDays => Enumerable.Range(5, 7).Select(d => new DayItem(new DateTime(2026, 10, d).ToString("ddd", CultureInfo.InvariantCulture), new DateTime(2026, 10, d), d == 10)).ToList();
    protected override async Task OnInitializedAsync() { await Api.RestoreAsync(); if (Api.IsSignedIn) await RefreshMatches(); }
    private async Task RefreshMatches() { var result = await Api.GetMatchesAsync(); if (result.Ok) myMatches = result.Matches.ToList(); }
    private void ToggleAccount() { showAccount = !showAccount; accountError = ""; }
    private void SwitchAccountMode() { accountMode = accountMode == "register" ? "login" : "register"; accountError = ""; }
    private async Task Authenticate()
    {
        accountBusy = true; accountError = "";
        try { var result = accountMode == "register" ? await Api.RegisterAsync(accountName, accountEmail, accountPassword) : await Api.LoginAsync(accountEmail, accountPassword); if (!result.Ok) { accountError = result.Message; return; } showAccount = false; accountPassword = ""; await RefreshMatches(); }
        catch (Exception ex) { accountError = $"Could not reach the Padel Match Sync API. Check that it is deployed and configured. ({ex.Message})"; }
        finally { accountBusy = false; }
    }
    private async Task SignOut() { await Api.SignOutAsync(); myMatches.Clear(); showAccount = false; }
    private void OpenPlanner() { showPlanner = true; toastMessage = null; lastShareUrl = ""; RefreshRangeDays(); }
    private void ClosePlanner() => showPlanner = false;
    private void ToggleDetails() => showDetails = !showDetails;
    private void SelectDay(DateTime day) => SelectedDay = day;
    private void ToggleCheck(int item) { if (!checkedItems.Add(item)) checkedItems.Remove(item); }
    private void SetDateMode(bool range) => useDateRange = range;
    private void SetSingleStatus(string? status) => singleDay.Status = status ?? "";
    private void RefreshRangeDays()
    {
        if (!IsRangeValid) return;
        var existing = rangeAvailability.ToDictionary(day => day.Date.Date);
        rangeAvailability = Enumerable.Range(0, (rangeEnd.Date - rangeStart.Date).Days + 1)
            .Select(offset => rangeStart.Date.AddDays(offset))
            .Select(date => existing.TryGetValue(date, out var day) ? day : new DayAvailability { Date = date })
            .ToList();
    }
    private static void UpdateStatus(DayAvailability day, string? status) => day.Status = status ?? "";
    private async Task SaveMatch()
    {
        if (saving || !CanSaveAvailability || !Api.IsSignedIn) return;
        saving = true;
        IEnumerable<DayAvailability> selectedDays = useDateRange ? rangeAvailability : new[] { new DayAvailability { Date = matchDate, Status = singleDay.Status, From = singleDay.From, Until = singleDay.Until } };
        var days = selectedDays.Select(day => new PadelMatchSync.Services.AvailabilityInput(DateOnly.FromDateTime(day.Date), day.Status, day.Status is "Available" or "Maybe" ? day.From : null, day.Status is "Available" or "Maybe" ? day.Until : null)).ToList();
        try { var result = await Api.CreateMatchAsync(new PadelMatchSync.Services.CreateMatchRequest(matchName, venue, days)); if (!result.Ok || result.Match is null) { toastMessage = result.Message; return; } showPlanner = false; lastShareUrl = Navigation.ToAbsoluteUri($"match/{result.Match.ShareCode}").ToString(); toastMessage = $"{matchName} saved with a private share link."; await RefreshMatches(); _ = ClearToast(); }
        catch (Exception ex) { toastMessage = $"Could not reach the Padel Match Sync API. ({ex.Message})"; }
        finally { saving = false; }
    }
    private async Task ClearToast() { await Task.Delay(3500); toastMessage = null; await InvokeAsync(StateHasChanged); }
}
