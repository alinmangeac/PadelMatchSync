@page "/match/{Code}"
@using PadelMatchSync.Services
@inject ApiClient Api

<PageTitle>Join a match · Padel Match Sync</PageTitle>
<main class="share-page">
    <a class="brand share-brand" href="./"><img src="padel-match-sync-icon.svg" alt="" /><span>Padel Match Sync</span></a>
    @if (loading) { <section class="share-card"><p>Loading match…</p></section> }
    else if (match is null) { <section class="share-card"><div class="modal-kicker">MATCH INVITATION</div><h1>Link unavailable</h1><p>@error</p><a class="primary-button share-home" href="./">Open Padel Match Sync</a></section> }
    else
    {
        <section class="share-card"><div class="modal-kicker">YOU’RE INVITED TO PLAY</div><h1>@match.Name</h1><p>@match.OrganizerName invited you · @match.Venue</p>
            <div class="shared-options"><h2>Possible days</h2>@foreach (var day in match.Availability) { <div class="shared-day"><strong>@day.Date.ToString("dddd, MMM d")</strong><span>@day.Status@if (day.From is not null) { <text> · @day.From–@day.Until</text> }</span></div> }</div>
            <div class="respond-form"><h2>When can you play?</h2><label>Your name<input @bind="playerName" maxlength="80" placeholder="e.g. Jordan" /></label>
                @foreach (var day in responseDays) { <div class="response-day"><strong>@day.Date.ToString("ddd, MMM d")</strong><select @bind="day.Status" aria-label="Your availability for @day.Date.ToString("MMM d")"><option value="">Choose</option><option>Available</option><option>Maybe</option><option>Unavailable</option></select>@if (day.Status is "Available" or "Maybe") { <select @bind="day.FromText" aria-label="Free from">@foreach (var time in TimeOptions) { <option value="@time">@time</option> }</select><span>to</span><select @bind="day.UntilText" aria-label="Free until">@foreach (var time in TimeOptions) { <option value="@time">@time</option> }</select> }</div> }
                @if (!string.IsNullOrWhiteSpace(error)) { <div class="range-message error">@error</div> }@if (!string.IsNullOrWhiteSpace(success)) { <div class="success-message">✓ @success</div> }
                <button class="primary-button modal-submit" @onclick="Submit" disabled="@(!CanSubmit || submitting)">@(submitting ? "Sending…" : "Send my availability") <span>→</span></button>
            </div>
            @if (match.Responses.Count > 0)
            {
                <div class="shared-options">
                    <h2>Common slots</h2>
                    @if (CommonSlots.Count == 0)
                    {
                        <p>No common 1½-hour or 2-hour slot yet. Everyone needs to be available on the same day.</p>
                    }
                    else
                    {
                        @foreach (var slot in CommonSlots)
                        {
                            <div class="shared-day"><strong>@slot.Date.ToString("ddd, MMM d")</strong><span>@slot.From.ToString("HH:mm")–@slot.Until.ToString("HH:mm") · @slot.DurationLabel</span></div>
                        }
                    }
                </div>
            }
            @if (match.Responses.Count > 0) { <div class="shared-options"><h2>Responses (@match.Responses.Count)</h2>@foreach (var response in match.Responses) { <div class="shared-response"><strong>@response.Name</strong>@foreach (var day in response.Availability) { <span>@day.Date.ToString("ddd, MMM d"): @day.Status@if (day.From is not null) { <text> · @day.From–@day.Until</text> }</span> }</div> }</div> }
        </section>
    }
</main>

@code {
    [Parameter] public string Code { get; set; } = "";
    private SharedMatchDetails? match;
    private List<ResponseDayInput> responseDays = [];
    private string playerName = "";
    private string error = "";
    private string success = "";
    private bool loading = true;
    private bool submitting;
    private IReadOnlyList<CommonSlot> CommonSlots => FindCommonSlots();
    private static bool IsHalfHour(TimeOnly time) => time.Ticks % (TimeSpan.TicksPerMinute * 30) == 0;
    private static readonly string[] TimeOptions = Enumerable.Range(0, 48).Select(index => TimeOnly.MinValue.AddMinutes(index * 30).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)).ToArray();
    private bool CanSubmit => match is not null && !string.IsNullOrWhiteSpace(playerName) && responseDays.Count > 0 && responseDays.All(day => !string.IsNullOrWhiteSpace(day.Status) && (day.Status is not ("Available" or "Maybe") || day.From < day.Until && IsHalfHour(day.From) && IsHalfHour(day.Until)));
    private IReadOnlyList<CommonSlot> FindCommonSlots()
    {
        if (match is null || match.Responses.Count == 0) return [];

        // Each submitted response is a participant. A response has one entry per
        // proposed date; absent entries are not available on that date.
        // A participant's response is authoritative for their availability. Organizer
        // dates are the proposed dates to show, not an extra participant constraint.
        var responseDayMaps = match.Responses
            .Select(response => response.Availability.GroupBy(day => day.Date)
                .ToDictionary(group => group.Key, group => group.Last()))
            .ToList();
        var slots = new List<CommonSlot>();
        foreach (var organizerDay in match.Availability.Where(day => day.Status == "Available" && day.From is not null && day.Until is not null))
        {
            var date = organizerDay.Date;
            var participants = new List<AvailabilityInput>();
            foreach (var days in responseDayMaps)
            {
                if (!days.TryGetValue(date, out var day) || day.Status != "Available" || day.From is null || day.Until is null) continue;
                participants.Add(day);
            }
            // Do not show a result until every submitted response is explicitly
            // available that day; Maybe and Unavailable are not confirmed availability.
            if (participants.Count != match.Responses.Count) continue;
            var start = participants.Max(day => day.From!.Value);
            var end = participants.Min(day => day.Until!.Value);
            if (start >= end) continue;

            // Availability is recorded on a half-hour grid. Show each valid 90-minute
            // window and each valid 2-hour window within the shared overlap.
            for (var at = start; at.AddMinutes(90) <= end; at = at.AddMinutes(30))
                slots.Add(new(date, at, at.AddMinutes(90), "1½ hours"));
            for (var at = start; at.AddMinutes(120) <= end; at = at.AddMinutes(30))
                slots.Add(new(date, at, at.AddMinutes(120), "2 hours"));
        }
        return slots;
    }
    protected override async Task OnParametersSetAsync()
    {
        loading = true; await Api.RestoreAsync();
        try { var result = await Api.GetSharedMatchAsync(Code); match = result.Match; error = result.Message; if (match is not null) responseDays = match.Availability.Select(day => new ResponseDayInput { Date = day.Date.ToDateTime(TimeOnly.MinValue), From = new(17, 0), Until = new(20, 0) }).ToList(); }
        catch { error = "The match service is unavailable. Please try again later."; }
        finally { loading = false; }
    }
    private async Task Submit()
    {
        if (!CanSubmit || submitting) return; submitting = true; error = ""; success = "";
        try { var input = responseDays.Select(day => new AvailabilityInput(DateOnly.FromDateTime(day.Date), day.Status, day.Status is "Available" or "Maybe" ? day.From : null, day.Status is "Available" or "Maybe" ? day.Until : null)).ToList(); var result = await Api.RespondAsync(Code, playerName, null, input); if (!result.Ok) error = result.Message; else { success = result.Message; await OnParametersSetAsync(); } }
        catch { error = "Could not send your availability. Please check your connection and try again."; }
        finally { submitting = false; }
    }
    private sealed class ResponseDayInput { public DateTime Date { get; set; } public string Status { get; set; } = ""; public TimeOnly From { get; set; } = new(17, 0); public TimeOnly Until { get; set; } = new(20, 0);
        public string FromText { get => From.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture); set { if (TimeOnly.TryParseExact(value, "HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var time)) From = time; } }
        public string UntilText { get => Until.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture); set { if (TimeOnly.TryParseExact(value, "HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var time)) Until = time; } } }
    private sealed record CommonSlot(DateOnly Date, TimeOnly From, TimeOnly Until, string DurationLabel);
}
