@page "/match/{Code}"
@using PadelMatchSync.Services
@inject ApiClient Api

<PageTitle>Join a match · Padel Match Sync</PageTitle>
<main class="share-page">
    <a class="brand share-brand" href="./"><img src="padel-match-sync-icon.svg" alt="" /><span>Padel Match Sync</span></a>
    @if (loading) { <section class="share-card"><p>Loading match…</p></section> }
    else if (match is null) { <section class="share-card"><div class="modal-kicker">MATCH INVITATION</div><h1>Link unavailable</h1><p>@error</p><a class="primary-button share-home" href="./">Open Padel Match Sync</a></section> }
    else
    {
        <section class="share-card"><div class="modal-kicker">YOU’RE INVITED TO PLAY</div><h1>@match.Name</h1><p>@match.OrganizerName invited you · @match.Venue</p>
            <div class="shared-options"><h2>Possible days</h2>@foreach (var day in match.Availability) { <div class="shared-day"><strong>@day.Date.ToString("dddd, MMM d")</strong><span>@day.Status@if (day.From is not null) { <text> · @day.From–@day.Until</text> }</span></div> }</div>
            <div class="respond-form"><h2>When can you play?</h2><label>Your name<input @bind="playerName" maxlength="80" placeholder="e.g. Jordan" /></label>
                @foreach (var day in responseDays) { <div class="response-day"><strong>@day.Date.ToString("ddd, MMM d")</strong><select @bind="day.Status" aria-label="Your availability for @day.Date.ToString("MMM d")"><option value="">Choose</option><option>Available</option><option>Maybe</option><option>Unavailable</option></select>@if (day.Status is "Available" or "Maybe") { <input type="time" step="1800" lang="en-GB" @bind="day.From" aria-label="Free from"/><span>to</span><input type="time" step="1800" lang="en-GB" @bind="day.Until" aria-label="Free until"/> }</div> }
                @if (!string.IsNullOrWhiteSpace(error)) { <div class="range-message error">@error</div> }@if (!string.IsNullOrWhiteSpace(success)) { <div class="success-message">✓ @success</div> }
                <button class="primary-button modal-submit" @onclick="Submit" disabled="@(!CanSubmit || submitting)">@(submitting ? "Sending…" : "Send my availability") <span>→</span></button>
            </div>
            @if (match.Responses.Count > 0) { <div class="shared-options"><h2>Responses (@match.Responses.Count)</h2>@foreach (var response in match.Responses) { <div class="shared-response"><strong>@response.Name</strong>@foreach (var day in response.Availability) { <span>@day.Date.ToString("ddd, MMM d"): @day.Status@if (day.From is not null) { <text> · @day.From–@day.Until</text> }</span> }</div> }</div> }
        </section>
    }
</main>

@code {
    [Parameter] public string Code { get; set; } = "";
    private SharedMatchDetails? match;
    private List<ResponseDayInput> responseDays = [];
    private string playerName = "";
    private string error = "";
    private string success = "";
    private bool loading = true;
    private bool submitting;
    private bool CanSubmit => match is not null && !string.IsNullOrWhiteSpace(playerName) && responseDays.Count > 0 && responseDays.All(day => !string.IsNullOrWhiteSpace(day.Status) && (day.Status is not ("Available" or "Maybe") || day.From < day.Until));
    protected override async Task OnParametersSetAsync()
    {
        loading = true; await Api.RestoreAsync();
        try { var result = await Api.GetSharedMatchAsync(Code); match = result.Match; error = result.Message; if (match is not null) responseDays = match.Availability.Select(day => new ResponseDayInput { Date = day.Date.ToDateTime(TimeOnly.MinValue), From = new(17, 0), Until = new(20, 0) }).ToList(); }
        catch { error = "The match service is unavailable. Please try again later."; }
        finally { loading = false; }
    }
    private async Task Submit()
    {
        if (!CanSubmit || submitting) return; submitting = true; error = ""; success = "";
        try { var input = responseDays.Select(day => new AvailabilityInput(DateOnly.FromDateTime(day.Date), day.Status, day.Status is "Available" or "Maybe" ? day.From : null, day.Status is "Available" or "Maybe" ? day.Until : null)).ToList(); var result = await Api.RespondAsync(Code, playerName, null, input); if (!result.Ok) error = result.Message; else { success = result.Message; await OnParametersSetAsync(); } }
        catch { error = "Could not send your availability. Please check your connection and try again."; }
        finally { submitting = false; }
    }
    private sealed class ResponseDayInput { public DateTime Date { get; set; } public string Status { get; set; } = ""; public TimeOnly From { get; set; } = new(17, 0); public TimeOnly Until { get; set; } = new(20, 0); }
}
